# /etc/nginx/sites-available/youshoubei
# 证书文件路径按 certbot/实际签发结果调整。

# HTTP:全部跳转 HTTPS,同时保留 ACME 验证路径
server {
    listen 80;
    listen [::]:80;
    server_name youshoubei.cn www.youshoubei.cn;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name youshoubei.cn www.youshoubei.cn;

    ssl_certificate     /etc/letsencrypt/live/youshoubei.cn/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/youshoubei.cn/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;

    client_max_body_size 6m;

    # 所有请求都由 Node 进程处理:静态缓存头在 server.js 里已设置
    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Accept-Encoding $http_accept_encoding;
        proxy_read_timeout 30s;
    }
}
