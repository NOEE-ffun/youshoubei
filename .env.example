# 复制为 .env 后可用 `npm start` 直接启动一体化服务；不要提交 .env
# 生产推荐 systemd EnvironmentFile(见 deploy/youshoubei.service),二选一即可
# 地域必须与运行 Node 的 ECS 同地域:
#   备案后正式 → 杭州:oss-cn-hangzhou(与现有 Vercel 用的桶相同)
#   临时无备案过渡 → 香港:oss-cn-hongkong
OSS_REGION=oss-cn-hangzhou
OSS_BUCKET=你的-bucket-名称
OSS_ACCESS_KEY_ID=你的AccessKeyId
OSS_ACCESS_KEY_SECRET=你的AccessKeySecret
# 可选：使用自定义域名或 CDN 域名。留空则使用默认 OSS 外网域名
OSS_PUBLIC_BASE_URL=https://你的域名
# 登录系统(2026-08 起):
#   SESSION_SECRET 未设置时每次重启随机生成,所有登录会话失效——生产务必固定一串随机字符
SESSION_SECRET=一串足够长的随机字符
# 超级管理员(2026-08-30 权限重构一期,逗号分隔名单,登录命中即动态升格 super,幂等):
#   SUPER_ADMIN_USERNAMES 引导存量账号(旧用户名密码登录命中即超管)
#   SUPER_ADMIN_PHONES 是全新环境的引导通道——第一条短信登录命中名单即超管
#SUPER_ADMIN_USERNAMES=alice,bob
#SUPER_ADMIN_PHONES=13800138000
# 短信登录(阿里云号码认证服务·短信认证 dypns;未开通可留空=短信功能不可用,站点其余功能不受影响)
#   签名/模板用控制台「系统赠送签名/模板」那套(免资质免报备,个人可办,无需自有短信签名)
#   平台生成验证码并由服务端校验(CheckSmsVerifyCode),本站不接触码明文
SMS_SIGN_NAME=
SMS_TEMPLATE_CODE=
# 可选:短信独立 AK(建议与 OSS 分权);留空回落复用上面 OSS_ACCESS_KEY_ID/SECRET
SMS_ACCESS_KEY_ID=
SMS_ACCESS_KEY_SECRET=
# 仅开发/E2E 的后门验证码:单码(如 123456)或 phone:code 逗号列表
#   显式配置即最高优先——本地 .env 配齐签名/模板也不影响开发/E2E 走后门
#   生产硬闸:NODE_ENV=production(systemd 已设)时后门一律失效,生产仍勿配置
#   真发联调:临时注释本行再调发送接口
#AUTH_DEV_SMS_CODE=123456
# OBS 舞台短链有效期(天),默认 7
POSTER_STAGE_TTL_DAYS=7
PORT=3000
